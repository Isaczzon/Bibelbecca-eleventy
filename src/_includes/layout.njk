{%- from "ikon.njk" import ikon -%}
{%- set kod = loc.code if loc else (lang or 'sv') -%}
{%- set lokal = locales | lokalFor(kod) -%}
{%- set ui = t[kod] -%}
{%- set sajten = sajt[kod] -%}
{%- set sidor = pages[kod] -%}
<!DOCTYPE html>
<html lang="{{ kod }}" data-culture="{{ kod }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if titel %}{{ titel }} – {% endif %}{{ sajten.logotopp }}</title>
    {%- set sidbeskrivning = beskrivning or (sajten.tagline.split('\n') | first) %}
    <meta name="description" content="{{ sidbeskrivning }}">
    {%- if noindex %}
    <meta name="robots" content="noindex">
    {%- else %}
    <link rel="canonical" href="{{ meta.basurl }}{{ page.url | url }}">
    {%- endif %}
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ sajten.logotopp }}">
    <meta property="og:title" content="{% if titel %}{{ titel }} – {% endif %}{{ sajten.logotopp }}">
    <meta property="og:description" content="{{ sidbeskrivning }}">
    <meta property="og:url" content="{{ meta.basurl }}{{ page.url | url }}">
    <meta property="og:image" content="{{ meta.basurl }}{{ '/images/delning.png' | url }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:locale" content="{{ lokal.iso | replace('-', '_') }}">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://i.ytimg.com">
    {#- Typsnitten laddas asynkront så att de inte blockerar första målningen;
        texten visas med systemtypsnitt och byts när fonterna kommit. -#}
    {%- set fontUrl = "https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800;900&family=Playfair+Display:ital,wght@1,400;1,500&family=Inter:wght@400;500;600&display=swap" %}
    <link rel="stylesheet" href="{{ fontUrl }}" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="{{ fontUrl }}"></noscript>
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
    <link rel="apple-touch-icon" href="/favicon-32.png">
    <meta name="theme-color" content="#141414">
    {#- CSS:en inlinas så att första målningen inte behöver vänta på en
        extra nätverksrundtur (sidan är liten nog för att det ska löna sig) -#}
    <style>{% include "../css/site.css" %}</style>
    <script>
        (function () {
            try {
                // 1. Sätt sparat tema före första målning (undviker blink).
                //    Nya besökare får mörkt – som BibelBeccas kanal.
                var savedTheme = localStorage.getItem('theme');
                document.documentElement.setAttribute('data-theme', savedTheme || 'dark');

            } catch (e) { /* localStorage saknas; kör vidare */ }
        })();
    </script>
</head>
<body>
<nav id="navbar">
    <div class="nav-inner">
        <a class="logo" href="/{{ lokal.prefix }}">
            <span class="logo-top">{{ sajten.logotopp }}</span>
            <span class="logo-bottom">{{ sajten.logobotten }}</span>
        </a>
        <ul class="nav-links" id="navLinks">
            <li><a href="/{{ lokal.prefix }}" {% if aktiv == 'hem' %}class="active"{% endif %}>{{ ui.hem }}</a></li>
            <li><a href="/{{ lokal.prefix }}om/" {% if aktiv == 'om' %}class="active"{% endif %}>{{ sidor.om.navnamn }}</a></li>
            <li><a href="/{{ lokal.prefix }}innehall/" {% if aktiv == 'media' %}class="active"{% endif %}>{{ sidor.media.navnamn }}</a></li>
            <li><a href="/{{ lokal.prefix }}sponsra/" {% if aktiv == 'sponsra' %}class="active"{% endif %}>{{ sidor.sponsra.navnamn }}</a></li>
            <li><a href="/{{ lokal.prefix }}kontakt/" {% if aktiv == 'kontakt' %}class="active"{% endif %}>{{ sidor.kontakt.navnamn }}</a></li>
        </ul>

        <div class="nav-actions">
            <button id="themeToggle" class="theme-toggle" type="button" aria-label="{{ ui.vaxlaTema }}" title="{{ ui.vaxlaTema }}">🌙</button>

        </div>

        <button type="button" class="hamburger" aria-label="{{ ui.meny }}" aria-expanded="false" aria-controls="navLinks">
            <span></span><span></span><span></span>
        </button>
    </div>
</nav>

<main>
{{ content | safe }}
</main>

<footer>
    <div class="footer-inner">
        <div>
            <div class="logo" style="margin-bottom:16px;">
                <span class="logo-top" style="color:white;">{{ sajten.logotopp }}</span>
                <span class="logo-bottom" style="color:var(--guld); display:inline;">{{ sajten.logobotten }}</span>
            </div>
            <p>{{ sajten.tagline | nl2br | safe }}</p>
        </div>
        <div>
            <h2>{{ ui.snabblankar }}</h2>
            <p><a href="/{{ lokal.prefix }}">{{ ui.hem }}</a></p>
            <p><a href="/{{ lokal.prefix }}om/">{{ sidor.om.navnamn }}</a></p>
            <p><a href="/{{ lokal.prefix }}innehall/">{{ sidor.media.navnamn }}</a></p>
            <p><a href="/{{ lokal.prefix }}sponsra/">{{ sidor.sponsra.navnamn }}</a></p>
            <p><a href="/{{ lokal.prefix }}kontakt/">{{ sidor.kontakt.navnamn }}</a></p>
        </div>
        <div>
            <h2>{{ ui.foljOss }}</h2>
            {% if sajten.youtube %}<p><a href="{{ sajten.youtube }}" target="_blank" rel="noopener">{{ ikon('youtube') }} YouTube</a></p>{% endif %}
            {% if sajten.instagram %}<p><a href="{{ sajten.instagram }}" target="_blank" rel="noopener">{{ ikon('instagram') }} Instagram</a></p>{% endif %}
            {% if sajten.tiktok %}<p><a href="{{ sajten.tiktok }}" target="_blank" rel="noopener">{{ ikon('tiktok') }} TikTok</a></p>{% endif %}
            {% if sajten.spotify %}<p><a href="{{ sajten.spotify }}" target="_blank" rel="noopener">{{ ikon('spotify') }} Spotify</a></p>{% endif %}
        </div>
        <div>
            <h2>{{ ui.kontaktRubrik }}</h2>
            <p><a href="mailto:{{ sajten.epost }}">{{ sajten.epost }}</a></p>
        </div>
    </div>
    <div class="footer-bottom">
        <p>© {{ aret }} {{ sajten.logotopp }}. {{ sajten.copyright }} · <a href="/{{ lokal.prefix }}integritet/">{{ sidor.integritet.navnamn }}</a></p>
    </div>
</footer>

<script src="/js/site.js"></script>
</body>
</html>
