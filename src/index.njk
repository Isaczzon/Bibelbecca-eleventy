---
layout: layout.njk
aktiv: hem
pagination:
  data: locales
  size: 1
  addAllPagesToCollections: true
  alias: loc
permalink: "/{{ loc.prefix }}index.html"
eleventyComputed:
  beskrivning: "{{ pages[loc.code].hem.om.text }}"
---
{%- from "ikon.njk" import ikon -%}
{%- set kod = loc.code -%}
{%- set sidan = pages[kod].hem -%}
{%- set ui = t[kod] -%}
{%- set sajten = sajt[kod] -%}
{%- set allaMedia = collections.media | medLang(kod) | utanTyp('Short') | nyastForst -%}

<section class="hero"{% if sidan.hero.bild %} style="background-image: linear-gradient(180deg, rgba(0,0,0,0.35), rgba(0,0,0,0.6)), url('{{ sidan.hero.bild | url }}'); background-size: cover; background-position: center;"{% endif %}>
    <div class="hero-content">
        {% if sidan.hero.badge %}<span class="hero-badge">📖 {{ sidan.hero.badge }}</span>{% endif %}
        <h1>{{ sidan.hero.rubrik }}</h1>
        <p>{{ sidan.hero.undertitel }}</p>
        {% if sidan.hero.knapptext %}
        <a class="hero-btn" href="/{{ loc.prefix }}innehall/">{{ sidan.hero.knapptext }}</a>
        {% endif %}
        {% if sajten.youtube %}
        <a class="hero-btn hero-btn--ghost hero-btn--youtube" href="{{ sajten.youtube }}" target="_blank" rel="noopener">▶ {{ ui.prenumerera }}</a>
        {% endif %}

        <div class="stats-rad">
            {% if sajten.foljare_youtube %}
            <div class="stat">
                <span class="stat-antal" data-mal="{{ sajten.foljare_youtube }}">{{ sajten.foljare_youtube | tal(loc.iso) }}</span>
                <span class="stat-etikett">{{ ikon('youtube', 14) }} {{ ui.statPrenumeranter }}</span>
            </div>
            {% endif %}
            {% if sajten.foljare_tiktok %}
            <div class="stat">
                <span class="stat-antal" data-mal="{{ sajten.foljare_tiktok }}">{{ sajten.foljare_tiktok | tal(loc.iso) }}</span>
                <span class="stat-etikett">{{ ikon('tiktok', 14) }} {{ ui.statFoljare }}</span>
            </div>
            {% endif %}
            {% if sajten.foljare_instagram %}
            <div class="stat">
                <span class="stat-antal" data-mal="{{ sajten.foljare_instagram }}">{{ sajten.foljare_instagram | tal(loc.iso) }}</span>
                <span class="stat-etikett">{{ ikon('instagram', 14) }} {{ ui.statFoljare }}</span>
            </div>
            {% endif %}
            {% if sajten.lyssnare_spotify %}
            <div class="stat">
                <span class="stat-antal" data-mal="{{ sajten.lyssnare_spotify }}">{{ sajten.lyssnare_spotify | tal(loc.iso) }}</span>
                <span class="stat-etikett">{{ ikon('spotify', 14) }} {{ ui.statLyssnare }}</span>
            </div>
            {% endif %}
        </div>
    </div>
</section>

{% if allaMedia.length %}
<section class="section">
    <div class="section-header fade-in">
        <h2>{{ sidan.senaste.rubrik }}</h2>
        <p>{{ sidan.senaste.undertitel }}</p>
    </div>
    <div class="video-list">
        {% for inslag in allaMedia %}{% if loop.index <= 3 %}
        {% set ytid = inslag.data.url | youtubeId %}
        <div class="video-block fade-in">
            <div class="video-embed">
                <button type="button" class="video-facade" data-yt="{{ ytid }}" aria-label="{{ ui.spela }}: {{ inslag.data.titel }}">
                    <img src="https://i.ytimg.com/vi/{{ ytid }}/hqdefault.jpg" alt="" loading="lazy" decoding="async">
                    <span class="video-play" aria-hidden="true">▶</span>
                </button>
            </div>
            <h3>{{ inslag.data.titel }}</h3>
            {% if inslag.data.datum %}<p class="video-date">{{ inslag.data.datum | datumLokal(kod) }}</p>{% endif %}
        </div>
        {% endif %}{% endfor %}
    </div>
    <p style="text-align:center; margin-top:32px;">
        <a class="hero-btn hero-btn--alt" href="/{{ loc.prefix }}innehall/">{{ ui.seAlla }} →</a>
    </p>
</section>
{% endif %}

<section class="section-alt">
    <div class="section">
        <div class="about-section fade-in" style="margin-bottom:0;">
            <div class="about-img about-img--foto">
                <img src="{{ '/images/hej-jag-ar-becca.jpg' | url }}" alt="Becca sitter vid poddmikrofonen med en uppslagen bibel framför sig" width="1000" height="944" loading="lazy" decoding="async">
            </div>
            <div class="about-text">
                <h2>{{ sidan.om.rubrik }}</h2>
                <p>{{ sidan.om.text }}</p>
                <a class="hero-btn hero-btn--alt" href="/{{ loc.prefix }}om/" style="margin-top:8px;">{{ sidan.om.knapptext }}</a>
            </div>
        </div>
    </div>
</section>

{% if sidan.fraga.rubrik %}
<section class="section" style="text-align:center;">
    <div class="fraga-ruta fade-in">
        <h2>💬 {{ sidan.fraga.rubrik }}</h2>
        <p>{{ sidan.fraga.text }}</p>
        <a class="hero-btn" href="/{{ loc.prefix }}kontakt/?amne={{ ui.kontakt.amnen[1] | urlencode }}">{{ sidan.fraga.knapptext }} →</a>
    </div>
</section>
{% endif %}

{% if sidan.cta.rubrik or sidan.cta.text %}
<section class="section" style="text-align:center;">
    <div class="fade-in">
        {% if sidan.cta.rubrik %}
        <h2 style="font-family:'Montserrat',sans-serif; font-weight:800; font-size:clamp(1.5rem,4vw,2.25rem); color:var(--text-heading); margin-bottom:16px;">{{ sidan.cta.rubrik }}</h2>
        {% endif %}
        {% if sidan.cta.text %}
        <p style="color:var(--text-muted); max-width:500px; margin:0 auto 24px;">{{ sidan.cta.text }}</p>
        {% endif %}
        {% if sidan.cta.knapptext %}
        <a class="hero-btn hero-btn--alt" href="/{{ loc.prefix }}sponsra/">{{ sidan.cta.knapptext }}</a>
        {% endif %}
    </div>
</section>
{% endif %}
