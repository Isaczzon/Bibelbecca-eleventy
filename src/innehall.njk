---
layout: layout.njk
aktiv: media
pagination:
  data: locales
  size: 1
  addAllPagesToCollections: true
  alias: loc
permalink: "/{{ loc.prefix }}innehall/index.html"
eleventyComputed:
  titel: "{{ pages[loc.code].media.navnamn }}"
  beskrivning: "{{ pages[loc.code].media.hero.undertitel }}"
---
{%- from "ikon.njk" import ikon -%}
{%- set kod = loc.code -%}
{%- set sidan = pages[kod].media -%}
{%- set ui = t[kod] -%}
{%- set sajten = sajt[kod] -%}
{%- set allaMedia = collections.media | medLang(kod) | nyastForst -%}

<section class="subpage-hero"{% if sidan.hero.bild %} style="background-image: linear-gradient(180deg, rgba(0,0,0,0.25), rgba(0,0,0,0.55)), url('{{ sidan.hero.bild | url }}'); background-size: cover; background-position: center;"{% endif %}>
    <h1>{{ sidan.hero.rubrik }}</h1>
    <p>{{ sidan.hero.undertitel }}</p>
</section>

<section class="section">
    <div class="kat-grid">
        {% for kat in medietyper %}
        {% set poster = allaMedia | medTyp(kat.typ) %}
        {% if poster.length %}
        {% set sektion = sidan[kat.nyckel] %}
        {% set senaste = poster[0] %}
        <a class="kat-card fade-in" href="/{{ loc.prefix }}innehall/{{ kat.slug }}/">
            <div class="kat-thumb">
                <img src="https://i.ytimg.com/vi/{{ senaste.data.url | youtubeId }}/hqdefault.jpg" alt=""{% if loop.index == 1 %} loading="eager" fetchpriority="high"{% else %} loading="lazy"{% endif %}>
            </div>
            <div class="kat-body">
                <h2>{{ sektion.rubrik }}</h2>
                <span class="kat-antal">{{ poster.length }} {{ ui.inslag }}</span>
                <p>{{ sektion.undertitel }}</p>
                <span class="kat-lank">{{ ui.utforska }} →</span>
            </div>
        </a>
        {% endif %}
        {% endfor %}
    </div>

    <p style="text-align:center; margin-top:48px;">
        {% if sajten.youtube %}<a class="hero-btn hero-btn--alt hero-btn--youtube" href="{{ sajten.youtube }}" target="_blank" rel="noopener">{{ ikon('youtube') }} {{ ui.prenumerera }}</a>{% endif %}
        {% if sajten.spotify %}<a class="hero-btn hero-btn--alt" href="{{ sajten.spotify }}" target="_blank" rel="noopener">{{ ikon('spotify') }} {{ ui.lyssnaSpotify }}</a>{% endif %}
        {% if sajten.tiktok %}<a class="hero-btn hero-btn--alt" href="{{ sajten.tiktok }}" target="_blank" rel="noopener">{{ ikon('tiktok') }} {{ ui.foljTiktok }}</a>{% endif %}
        {% if sajten.instagram %}<a class="hero-btn hero-btn--alt" href="{{ sajten.instagram }}" target="_blank" rel="noopener">{{ ikon('instagram') }} {{ ui.foljInstagram }}</a>{% endif %}
    </p>
</section>
